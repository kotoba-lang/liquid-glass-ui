{:paths ["src" "resources"]
 ;; Portable .cljc visual skin over shitsuke (tokens + hiccup + style + component
 ;; primitives + re-frame seam). liquid-glass-ui owns no interaction/state logic —
 ;; it wraps shitsuke.components hiccup with glass material classes + a specular
 ;; highlight decoration, and adds its own token/style layer for the material
 ;; itself (blur/saturate/tint/elevation/specular/radius/motion). Runtime deps:
 ;; shitsuke (component/dual-render contract) + kotoba-lang/css (component-css
 ;; is generated from EDN rule data via css.core, not hand-typed CSS strings —
 ;; liquid-glass-ui is css.core's first real consumer). Real reagent/re-frame/
 ;; shadow-css are build/dev aliases only (same split as chobo/mise/senden).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/shitsuke.git"
         ;; act->str is public here — liquid-glass no longer carries a copy
         :git/sha "886560328fa448f429a1744c9f86a56bb36fb109"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css.git"
         ;; inferred option fallback in document renderer
         :git/sha "e10adeb678148eccb9a069819454ceb40ec8ee91"}}
 :aliases
 {:test  {:extra-paths ["test"]
          ;; kotoba-lang/amu is TEST-ONLY, for the form-A + D6 document
          ;; parity gates (ADR-2607270100 §10). Component hiccup wrappers and
          ;; style.cljc stay on the .cljc side.
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                       io.github.kotoba-lang/amu
                       {:git/url "https://github.com/kotoba-lang/amu.git"
                        ;; inferred option fallback and contextual document keys
                        :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}
          :main-opts ["-m" "cognitect.test-runner"]
          :exec-fn cognitect.test-runner.api/test}
  :local {:override-deps {io.github.kotoba-lang/shitsuke {:local/root "../shitsuke"}
                          io.github.kotoba-lang/css {:local/root "../css"}}}
  :cljs  {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                       reagent/reagent           {:mvn/version "1.2.0"}
                       re-frame/re-frame         {:mvn/version "1.4.3"}}}
  :pages {:extra-deps {com.thheller/shadow-css {:mvn/version "0.6.1"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
