(ns liquid-glass-tokens-document)

;; Delivery 6 fourth cutover (css → html → shitsuke → **liquid-glass-ui**):
;; Logical token-group `:document` → `--liquid-glass-*` CSS-var stream.
;; Form-A `tokens_core.kotoba` remains oracle. ≤4 value params on recursion.
;; Capability-free (kotoba/pure). spring-linear-easing stays host-side.

(defn entry [name :keyword value :string] :document
  (document-map :name (document-keyword name)
                :value (document-string value)))

(defn group-doc [group :string entries :document] :document
  (document-map :prefix (document-string "liquid-glass")
                :group (document-string group)
                :entries entries))

(defn nested-doc [group :string k :string props :document] :document
  (document-map :prefix (document-string "liquid-glass")
                :group (document-string group)
                :name (document-string k)
                :nested (document-bool true)
                :props props))

(defn str-field [d :document k :keyword] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d k) (document-null)))
    ""))

(defn name-of-entry [d :document] :string
  (keyword-name
   (option-value-of [:option :keyword]
     (document-keyword-value
       (option-value-of [:option :document]
         (document-get d :name) (document-null)))
     :missing)))

(defn value-of-entry [d :document] :string
  (str-field d :value))

(defn entries-of [d :document] :document
  (option-value-of [:option :document]
    (document-get d :entries) (document-vector)))

(defn props-of [d :document] :document
  (option-value-of [:option :document]
    (document-get d :props) (document-vector)))

(defn nested? [d :document] :bool
  (option-value-of [:option :bool]
    (document-bool-value
      (option-value-of [:option :document]
        (document-get d :nested) (document-null)))
    false))

(defn decl [name :string value :string] :string
  (string-concat "  "
                 (string-concat name
                                (string-concat ": "
                                               (string-concat value ";")))))

(defn join-nl [a :string b :string] :string
  (string-concat a (string-concat "\n" b)))

(defn css-var-name2 [group :string k :string] :string
  (string-concat "--liquid-glass-"
                 (string-concat group (string-concat "-" k))))

(defn scalar-line [d :document e :document] :string
  (decl (css-var-name2 (str-field d :group) (name-of-entry e))
        (value-of-entry e)))

(defn nested-line [d :document e :document] :string
  (decl (string-concat (css-var-name2 (str-field d :group) (str-field d :name))
                       (string-concat "-" (name-of-entry e)))
        (value-of-entry e)))

(defn render-entries-from [d :document i :i64 acc :string] :string
  (let [entries (entries-of d)
        n (document-count entries)]
    (if (>= i n)
      acc
      (let [line (scalar-line d
                   (option-value-of [:option :document]
                     (document-vector-at entries i) (document-null)))
            next (if (string=? acc "") line (join-nl acc line))]
        (render-entries-from d (+ i 1) next)))))

(defn render-props-from [d :document i :i64 acc :string] :string
  (let [props (props-of d)
        n (document-count props)]
    (if (>= i n)
      acc
      (let [line (nested-line d
                   (option-value-of [:option :document]
                     (document-vector-at props i) (document-null)))
            next (if (string=? acc "") line (join-nl acc line))]
        (render-props-from d (+ i 1) next)))))

(defn render-group [d :document] :string
  (if (nested? d)
    (render-props-from d 0 "")
    (render-entries-from d 0 "")))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

(defn dark-root-css [body :string] :string
  (string-concat "@media (prefers-color-scheme: dark) {\n:root {\n"
                 (string-concat body "\n}\n}")))

;; --- sample corpora (match form-A tokens_core sample-*) -------------------

(defn sample-radius-doc [] :document
  (group-doc "radius"
    (document-vector
     (entry :lg "24px") (entry :md "16px")
     (entry :pill "999px") (entry :sm "10px"))))

(defn sample-accent-doc [] :document
  (group-doc "accent"
    (document-vector
     (entry :tint "rgba(10,132,255,0.55)")
     (entry :tint-strong "rgba(10,132,255,0.85)"))))

(defn sample-ink-doc [] :document
  (group-doc "ink"
    (document-vector
     (entry :default "#1c1c1e")
     (entry :shadow "0 1px 2px rgba(255,255,255,.4)"))))

(defn sample-lens-doc [] :document
  (group-doc "lens"
    (document-vector
     (entry :frequency "0.008") (entry :octaves "2") (entry :scale "8"))))

(defn sample-regular-surface-doc [] :document
  (nested-doc "surface" "regular"
    (document-vector
     (entry :blur "20px")
     (entry :border "rgba(255,255,255,0.35)")
     (entry :saturate "180%")
     (entry :tint "rgba(255,255,255,0.14)"))))

(defn sample-press-motion-doc [] :document
  (nested-doc "motion" "press"
    (document-vector
     (entry :duration "120ms")
     (entry :easing "cubic-bezier(.32,.72,0,1)")
     (entry :scale-x "1.02")
     (entry :scale-y ".95"))))

(defn sample-light-root [] :string
  (root-css
   (join-nl (render-group (sample-regular-surface-doc))
            (join-nl (render-group (sample-radius-doc))
                     (join-nl (render-group (sample-accent-doc))
                              (join-nl (render-group (sample-lens-doc))
                                       (join-nl (render-group (sample-ink-doc))
                                                (render-group (sample-press-motion-doc)))))))))

(defn sample-dark-ink-doc [] :document
  (group-doc "ink"
    (document-vector
     (entry :default "#f5f5f7")
     (entry :shadow "0 1px 3px rgba(0,0,0,.45)"))))

(defn sample-dark-regular-surface-doc [] :document
  (nested-doc "surface" "regular"
    (document-vector
     (entry :border "rgba(255,255,255,0.12)")
     (entry :tint "rgba(20,20,24,0.42)"))))

(defn sample-dark-root [] :string
  (dark-root-css
   (join-nl (render-group (sample-dark-regular-surface-doc))
            (render-group (sample-dark-ink-doc)))))

(defn group-digest [d :document] :string
  (document-sha256 d))

(defn group-print [d :document] :string
  (document-print d))

(defn group-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (join-nl (sample-light-root) (sample-dark-root))))
